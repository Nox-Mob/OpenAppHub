# Copy to .env.local for local development (never commit real values).
# Deployed environments take these from wrangler.jsonc `vars` (public) and
# Worker secrets (private). Anything VITE_* is shipped to the browser.

# --- Public (wrangler.jsonc vars) ---
VITE_HOSTED=false
VITE_APP_ID=hub
# openapphub-staging or a project of your own (never the old projects)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_HUB_URL=http://localhost:3000
# Hosted only: share the session across *.openapphub.org
VITE_COOKIE_DOMAIN=
# JSON object of suite app origins (hub, charter, board, ledger). The hub only
# sends people to these after sign-in; the dashboard links to them.
VITE_SUITE_URLS={"hub":"http://localhost:3000","charter":"https://charter.openapphub.org","board":"https://board.openapphub.org","ledger":"https://ledger.openapphub.org"}
VITE_DOCS_URL=https://docs.openapphub.org
# false shows "Sign-ups are closed" instead of the sign-up form
VITE_SIGNUPS_OPEN=true

# --- Worker secrets (wrangler secret put NAME --env staging|production) ---
# Not used yet; listed so nothing is forgotten (SHARED-SPEC §7).
# SUPABASE_SERVICE_ROLE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- Migrations (scripts/migrate.mjs) ---
# Supabase Session pooler string (port 5432), or a local Postgres.
# DATABASE_URL=postgres://...
