      "params_schema": {
        "limit": {
          "max": 5000,
          "min": 1,
          "type": "int",
          "label": "At most",
          "optional": true
        },
        "status": {
          "type": "choice",
          "label": "Which",
          "options": ["open", "overdue", "done", "any"]
