{
  "actions": [
    {
      "app": "board",
      "kind": "query",
      "sort": 5,
      "type": "board.find_meetings",
      "label": "Find board meetings",
      "run_fn": "board.wf_find_meetings",
      "requires": [],
      "description": "Look up meetings in a window of days (for example the next 30), to use in later steps.",
      "output_schema": [
        {
          "key": "rows",
          "type": "list",
          "label": "Meetings",
          "fields": [
            {
              "key": "id",
              "type": "text",
              "label": "Meeting"
            },
            {
              "key": "title",
              "type": "text",
              "label": "Title"
            },
            {
              "key": "date",
              "type": "date",
              "label": "Date"
            },
            {
              "key": "start_time",
              "type": "text",
              "label": "Start time"
            },
            {
              "key": "location",
              "type": "text",
              "label": "Location"
            },
            {
              "key": "days_away",
              "type": "number",
              "label": "Days away"
            }
          ]
        },
        {
          "key": "count",
          "type": "number",
          "label": "How many"
        }
      ],
      "params_schema": {
        "limit": {
          "max": 1000,
          "min": 1,
          "type": "int",
          "label": "At most",
          "optional": true
        },
        "status": {
          "type": "choice",
          "label": "Status",
          "options": ["scheduled", "draft", "completed", "any"]
        },
        "to_days": {
          "max": 3650,
          "min": -3650,
          "type": "int",
          "label": "To (days from today)",
          "optional": true
        },
        "from_days": {
          "max": 3650,
          "min": -3650,
          "type": "int",
          "label": "From (days from today; negative for the past)",
          "optional": true
        }
      }
    },
    {
      "app": "charter",
      "kind": "query",
      "sort": 5,
      "type": "charter.find_members",
      "label": "Find members",
      "run_fn": "charter.wf_find_members",
      "requires": [],
      "description": "Look up members, for example everyone whose membership ends in the next 30 days, to use in later steps.",
      "output_schema": [
        {
          "key": "rows",
          "type": "list",
          "label": "Members",
          "fields": [
            {
              "key": "name",
              "type": "text",
              "label": "Name"
            },
            {
              "key": "email",
