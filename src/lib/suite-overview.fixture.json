              "label": "Level"
            },
            {
              "key": "term",
              "type": "text",
              "label": "Term"
            },
            {
              "key": "paid_through",
              "type": "date",
              "label": "Paid through"
            },
            {
              "key": "joined_on",
              "type": "date",
              "label": "Joined"
            },
            {
              "key": "chapter",
              "type": "text",
              "label": "Chapter"
            },
            {
              "key": "standing",
              "type": "text",
              "label": "Standing"
            },
            {
              "key": "user_id",
              "type": "text",
              "label": "Account"
            },
            {
              "key": "fields",
              "type": "object",
              "label": "Member fields"
            }
          ]
        },
        {
          "key": "count",
          "type": "number",
          "label": "How many"
        },
        {
          "key": "total",
          "type": "number",
          "label": "How many matched (before the limit)"
        }
      ],
      "params_schema": {
        "level": {
          "type": "text",
          "label": "Level (optional)",
          "optional": true
        },
        "limit": {
          "max": 5000,
          "min": 1,
          "type": "int",
          "label": "At most",
          "optional": true
        },
        "chapter": {
          "type": "text",
          "label": "Chapter (optional)",
          "optional": true
        },
        "standing": {
          "type": "choice",
          "label": "Standing",
          "options": ["current", "lapsed", "pending", "any"]
        },
        "joined_within_days": {
          "max": 3650,
          "min": 0,
          "type": "int",
          "label": "Joined in the last (days, optional)",
          "optional": true
        },
        "expires_within_days": {
          "max": 730,
          "min": 0,
          "type": "int",
          "label": "Membership ends within (days, optional)",
          "optional": true
        }
      }
    },
    {
      "app": "ledger",
