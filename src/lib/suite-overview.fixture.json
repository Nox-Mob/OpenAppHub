          "label": "Books closed for it"
        }
      ],
      "params_schema": {
        "date": {
          "type": "date",
          "label": "Date (for \"date\")",
          "optional": true
        },
        "month": {
          "type": "choice",
          "label": "Which month",
          "options": ["last_closed_month", "this_month", "date"]
        }
      }
    },
