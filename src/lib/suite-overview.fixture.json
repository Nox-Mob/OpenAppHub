      ],
      "params_schema": {
        "date": {
          "type": "date",
          "label": "Date",
          "optional": true
        },
        "as_of": {
          "help": "The last closed month: the month the books are locked through. Today: the year so far. A date: the year up to that day.",
          "type": "choice",
          "label": "As of",
          "options": ["last_closed_month", "today", "date"]
        }
      }
    }
