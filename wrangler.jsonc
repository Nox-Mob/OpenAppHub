// Cloudflare Worker config for the hub (SHARED-SPEC §10).
//
// The TOP LEVEL is production. Cloudflare's Git integration builds `main` with
// `npm run build` and deploys with `npx wrangler deploy`, which uses the top level.
//   staging      CLOUDFLARE_ENV=staging npm run build && npx wrangler deploy
//   development  npm run dev (sets CLOUDFLARE_ENV=development)
//
// Public settings are `vars`: anything VITE_* is also shipped to the browser.
// Secrets are set in the Cloudflare dashboard (Worker → Settings → Variables and
// Secrets) or with `wrangler secret put`, never here. See docs/SECRETS.md.
// Wrangler environments don't inherit `vars`, so each environment repeats them.
// VITE_SUITE_URLS is a JSON object of app origins: {"hub","charter","board","ledger"}.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openapphub",
  "main": "src/server.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "routes": [{ "pattern": "openapphub.org", "custom_domain": true }],
  // The suite's email sender (S-16, src/lib/email.server.ts): every 5 minutes.
  // It sends nothing until RESEND_API_KEY and SUPABASE_SERVICE_ROLE_KEY are set.
  "triggers": { "crons": ["*/5 * * * *"] },

  // Production: openapphub-prod (SHARED-SPEC §0.1). The publishable key is public by design.
  "vars": {
    "VITE_HOSTED": "true",
    "VITE_APP_ID": "hub",
    "VITE_SUPABASE_URL": "https://ymlesgadawnjupnvgokd.supabase.co",
    "VITE_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_EbrHHQxIvTGPgEgjEkkpDQ_FROfdRln",
    "VITE_HUB_URL": "https://openapphub.org",
    "VITE_COOKIE_DOMAIN": ".openapphub.org",
    "VITE_SUITE_URLS": "{\"hub\":\"https://openapphub.org\",\"charter\":\"https://charter.openapphub.org\",\"board\":\"https://board.openapphub.org\",\"ledger\":\"https://ledger.openapphub.org\"}",
    "VITE_DOCS_URL": "https://docs.openapphub.org",
    // Sign-ups stay closed until launch (START-HERE).
    "VITE_SIGNUPS_OPEN": "false",
    // Email (S-16). The domain must be verified in Resend.
    "EMAIL_FROM": "OpenAppHub <notifications@openapphub.org>",
  },

  "env": {
    "staging": {
      "name": "openapphub-staging",
      "routes": [{ "pattern": "staging.openapphub.org", "custom_domain": true }],
      "triggers": { "crons": ["*/5 * * * *"] },
      // openapphub-staging (SHARED-SPEC §0.1).
      "vars": {
        "VITE_HOSTED": "true",
        "VITE_APP_ID": "hub",
        "VITE_SUPABASE_URL": "https://mbloxixlykmbuuoaprnx.supabase.co",
        "VITE_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_XsbfqXRDX-L_TwmtYGvjDg_qiLKka2X",
        "VITE_HUB_URL": "https://staging.openapphub.org",
        "VITE_COOKIE_DOMAIN": ".openapphub.org",
        // The apps' staging sites are their Workers' previews of branch `staging`.
        "VITE_SUITE_URLS": "{\"hub\":\"https://staging.openapphub.org\",\"charter\":\"https://staging.charter.staging.openapphub.org\",\"board\":\"https://staging.board.staging.openapphub.org\",\"ledger\":\"https://staging.ledger.staging.openapphub.org\"}",
        // Sign-in may also return to any branch preview: <branch>.<one of these>.
        "VITE_PREVIEW_DOMAINS": "charter.staging.openapphub.org,board.staging.openapphub.org,ledger.staging.openapphub.org",
        "VITE_DOCS_URL": "https://docs.openapphub.org",
        "VITE_SIGNUPS_OPEN": "true",
        // Sign-in buttons for the suite demo accounts (db/seed/0002_suite_demo.sql). Staging only.
        "VITE_DEMO_LOGIN": "true",
        "EMAIL_FROM": "OpenAppHub staging <notifications@openapphub.org>",
      },
    },

    // Local development only (`npm run dev`): staging's database, never production.
    // Override with your own project in .env.local.
    "development": {
      "name": "openapphub-dev",
      "vars": {
        "VITE_HOSTED": "false",
        "VITE_APP_ID": "hub",
        "VITE_SUPABASE_URL": "https://mbloxixlykmbuuoaprnx.supabase.co",
        "VITE_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_XsbfqXRDX-L_TwmtYGvjDg_qiLKka2X",
        "VITE_HUB_URL": "http://localhost:3000",
        "VITE_COOKIE_DOMAIN": "",
        "VITE_SUITE_URLS": "{\"hub\":\"http://localhost:3000\"}",
        "VITE_DOCS_URL": "https://docs.openapphub.org",
        "VITE_SIGNUPS_OPEN": "true",
      },
    },
  },
}
