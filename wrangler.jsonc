// Cloudflare Worker config for the hub (SHARED-SPEC §10).
// Public settings are `vars` (anything VITE_* is also shipped to the browser).
// Secrets are set with `wrangler secret put <NAME> --env <env>`, never here:
//   SUPABASE_SERVICE_ROLE_KEY, STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, STRIPE_PRICE_MAP
// Wrangler environments don't inherit `vars`, so each environment repeats them.
// Build for an environment with CLOUDFLARE_ENV=<env> (see the workflows).
// VITE_SUITE_URLS is a JSON object of app origins: {"hub","charter","board","ledger"}.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openapphub",
  "main": "src/server.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Local development (`npm run dev`) uses openapphub-staging, never production.
  // Override with your own project in .env.local.
  "vars": {
    "VITE_HOSTED": "false",
    "VITE_APP_ID": "hub",
    "VITE_SUPABASE_URL": "https://mbloxixlykmbuuoaprnx.supabase.co",
    "VITE_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_XsbfqXRDX-L_TwmtYGvjDg_qiLKka2X",
    "VITE_HUB_URL": "http://localhost:3000",
    "VITE_COOKIE_DOMAIN": "",
    "VITE_SUITE_URLS": "{\"hub\":\"http://localhost:3000\"}",
    "VITE_DOCS_URL": "https://docs.openapphub.org",
    "VITE_SIGNUPS_OPEN": "true",
  },

  "env": {
    "staging": {
      "name": "openapphub-staging",
      "routes": [{ "pattern": "staging.openapphub.org", "custom_domain": true }],
      "vars": {
        "VITE_HOSTED": "true",
        "VITE_APP_ID": "hub",
        // openapphub-staging (SHARED-SPEC §0.1). The publishable key is public by design.
        "VITE_SUPABASE_URL": "https://mbloxixlykmbuuoaprnx.supabase.co",
        "VITE_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_XsbfqXRDX-L_TwmtYGvjDg_qiLKka2X",
        "VITE_HUB_URL": "https://staging.openapphub.org",
        "VITE_COOKIE_DOMAIN": ".openapphub.org",
        "VITE_SUITE_URLS": "{\"hub\":\"https://staging.openapphub.org\",\"charter\":\"https://charter-staging.openapphub.org\",\"board\":\"https://board-staging.openapphub.org\",\"ledger\":\"https://ledger-staging.openapphub.org\"}",
        "VITE_DOCS_URL": "https://docs.openapphub.org",
        "VITE_SIGNUPS_OPEN": "true",
      },
    },
    "production": {
      "name": "openapphub",
      "routes": [{ "pattern": "openapphub.org", "custom_domain": true }],
      "vars": {
        "VITE_HOSTED": "true",
        "VITE_APP_ID": "hub",
        // openapphub-prod (SHARED-SPEC §0.1). The publishable key is public by design.
        "VITE_SUPABASE_URL": "https://ymlesgadawnjupnvgokd.supabase.co",
        "VITE_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_EbrHHQxIvTGPgEgjEkkpDQ_FROfdRln",
        "VITE_HUB_URL": "https://openapphub.org",
        "VITE_COOKIE_DOMAIN": ".openapphub.org",
        "VITE_SUITE_URLS": "{\"hub\":\"https://openapphub.org\",\"charter\":\"https://charter.openapphub.org\",\"board\":\"https://board.openapphub.org\",\"ledger\":\"https://ledger.openapphub.org\"}",
        "VITE_DOCS_URL": "https://docs.openapphub.org",
        // Sign-ups stay closed until launch (START-HERE).
        "VITE_SIGNUPS_OPEN": "false",
      },
    },
  },
}
